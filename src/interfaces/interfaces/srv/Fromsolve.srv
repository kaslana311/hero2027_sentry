int32 nums                  # 装甲板数量n
bool track                  # 是否在跟踪状态，0为否，1为是
int32 old_armor_x           # 上一帧装甲板的x
int32 old_armor_y           # 上一帧装甲板的y
int32 old_armor_height      # 上一帧装甲板的height
int32 old_armor_width       # 上一帧装甲板的width
int32 old_armor_angle       # 上一帧装甲板的angle
int32 old_armor_color       # 上一帧装甲板的color，0红，1蓝，3灰，4错误
int32[] center_xs           # 表示灯条的旋转矩形的中心点坐标之x       2n
int32[] center_ys           # 表示灯条的旋转矩形的中心点坐标之y       2n
int32[] heights             # 表示灯条的旋转矩形的高度               2n
int32[] widths              # 表示灯条的旋转矩形的宽度               2n
float64[] angles            # 表示灯条的旋转矩形的角度               2n
int32[] class_nums          # n个装甲板对应的数字
int32[] armor_colors        # n个装甲板对应的颜色
int32 light_per             # 第一个装甲板的亮点数
int32 isbigarmor           # 第一个装甲板大小装甲板标志位
bool flag_switch_armor      # 切换目标标志位
bool armor_found            # 是否找到目标装甲板
